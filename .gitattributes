# Tutti i file di testo in LF, nel repository e nella cartella di lavoro.
# Così una build su Windows non fa risultare modificati file identici.
* text=auto eol=lf

# I batch di Windows restano in CRLF: con LF cmd.exe può leggere male etichette e commenti "::".
*.bat text eol=crlf
*.cmd text eol=crlf

*.xlsx binary
*.ods binary
*.docx binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
