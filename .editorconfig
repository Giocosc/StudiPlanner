# Impostazioni comuni per gli editor (VS Code, JetBrains, Notepad++ con plugin, …)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{js,mjs,json,html,css,md}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
